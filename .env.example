# Example environment variables for kmrl-doc-processor
# Copy this file to `.env` and fill in real values.

# Server
PORT=3000

# Database (local file path or connection string)
DB_PATH=./storage/documents

# API keys / services
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SUMMARIZATION_MODEL=gpt-4o-mini

# Feature toggles
ENABLE_OCR=true
ENABLE_NER=true
